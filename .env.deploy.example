# Shopify Configuration
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token
SHOPIFY_REVALIDATION_SECRET=your-revalidation-secret

# Site Configuration
COMPANY_NAME=DressShop
SITE_NAME=DressShop - Women's Fashion
NEXT_PUBLIC_SITE_NAME=DressShop

# Optional: Payment Provider (Stripe as example)
# STRIPE_PUBLIC_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx

# Optional: Delivery Provider (Russian Post as example)
